# ==========================================================
# FinGuard AI - Root .gitignore (Monorepo: AI + NestJS + Next.js)
# ==========================================================

# ----------------------------------------------------------
# 1. SECRETS, ENV & API KEYS (TUYỆT ĐỐI KHÔNG COMMIT)
# ----------------------------------------------------------
.env
.env.*
!.env.example
*.env
!*.env.example

# Keys, certificates & cloud credentials
*.pem
*.key
*.p12
*.pfx
*secret*.json
*credentials*.json
service-account*.json
google-services.json
.secrets/

# ----------------------------------------------------------
# 2. AI ENGINE (PYTHON + CHROMADB + ML CACHE)
# ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & linting cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local Vector Store & DB binaries (sinh ra khi chạy ingest_kb.py)
ai_engine/vector_store/
vector_store/
*.sqlite3
*.sqlite3-journal
*.db
chroma.sqlite3

# Model weights & cache
.cache/
*.onnx
*.bin
*.pt
*.pth

# ----------------------------------------------------------
# 3. BACKEND (NESTJS) & FRONTEND (NEXT.JS / NODE.JS)
# ----------------------------------------------------------
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Test coverage & package manager logs
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------------------------------------
# 4. DOCKER, LOGS, UPLOADS & TEMP FILES
# ----------------------------------------------------------
*.log
logs/
tmp/
temp/
uploads/
*.tmp
*.bak

# ----------------------------------------------------------
# 5. IDE & OS CLUTTER
# ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
